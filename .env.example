# Core runtime
CLIPULSE_DATABASE_URL=sqlite+pysqlite:///./clipulse.sqlite3
CLIPULSE_STATE_DIR=./.clipulse-state

# Protected dashboard and write APIs
# Uncomment and replace these before enabling protected mode.
# CLIPULSE_DASHBOARD_TOKEN=replace-with-a-random-dashboard-token
# CLIPULSE_API_BEARER_TOKEN=replace-with-a-random-api-token
# CLIPULSE_SESSION_SECRET=replace-with-a-long-random-session-secret

# Public badge and README snippet routes (opt-in only)
# CLIPULSE_ENABLE_PUBLIC_READS=1
# CLIPULSE_PUBLIC_BASE_URL=https://clipulse.example.com

# Optional deployment smoke inputs for public-route checks
# CLIPULSE_BASE_URL=http://127.0.0.1:8000
# CLIPULSE_EXPECT_PUBLIC_READS=1
# CLIPULSE_PUBLIC_PROBE_URL=https://clipulse.example.com

# Optional compatibility and local-dev toggles
# CLIPULSE_ALLOW_INSECURE_NO_AUTH=1
# CLIPULSE_SERVER_TOKEN=legacy-single-token
# CLIPULSE_LOGOUT_CLEAR_SITE_DATA=1
# CLIPULSE_FORCE_SECURE_SESSION_COOKIE=1
# CLIPULSE_STATE_RETENTION_DAYS=14
# CLIPULSE_STATE_MAX_FILES=200
# CLIPULSE_STATE_MAX_SPOOL_BYTES=67108864
# CLIPULSE_OPENCODE_ENABLE_SESSION_DIFF=1
